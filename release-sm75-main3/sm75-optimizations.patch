+    kvc = kvcache_fp8.view(-1, page * (D + 4))
+    kvc_b = kvc if kvc.dtype == torch.uint8 else kvc.view(torch.uint8)
+    q_b = (
+        q_fp8[:, 0].view(torch.uint8)
+        if q_fp8.dtype != torch.uint8
+        else q_fp8[:, 0]
+    )
+    _mqa_paged_smallq_kernel[(triton.cdiv(max_seq_len, 32), bsz)](
+        q_b,
+        kvc_b,
+        page_table,
+        seq_lens,
+        weight,
+        out,
+        page_table.shape[1],
+        max_seq_len,
+        q_fp8.stride(0),
+        q_fp8.stride(2),
+        page_table.stride(0),
+        weight.stride(0),
+        out.stride(0),
+        PAGE=page,
+        H=H,
+        D=D,
+        BLOCK_T=32,
+        num_warps=4,
+        num_stages=1,
+    )
+    return out
