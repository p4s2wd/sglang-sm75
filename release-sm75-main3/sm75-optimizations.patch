+                        page_ids,
+                        page_offs,
+                        idx_valid,
+                        page_bytes,
+                        scale_section_off,
+                    ),
+                )
+            else:
+                kv2 = _hs_load_nope(
+                    cache_u8_ptr,
+                    lut_ptr,
+                    tok_base,
+                    2 * NCOL + offs_c,
+                    page_ids,
+                    page_offs,
+                    idx_valid,
+                    page_bytes,
+                    scale_section_off,
