+        if NCHUNK >= 6:
+            if _HS_QK_TRANSPOSED:
+                scores += tl.dot(
+                    q5,
+                    _hs_load_nope_t(
+                        cache_u8_ptr,
+                        lut_ptr,
+                        tok_base,
+                        5 * NCOL + offs_c,
+                        page_ids,
+                        page_offs,
+                        idx_valid,
+                        page_bytes,
+                        scale_section_off,
+                    ),
